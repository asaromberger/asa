<h1><%= @title %></h1>

<% if @unknowns.count > 0 %>
	<h4>Unknown</h4>
	<ul>
	<% @unknowns.each do |unknown| %>
		<li><%= unknown %></li>
	<% end %>
	</ul>
<% end %>

<table class='table-bordered table-striped fixed-header'>

<thead>
	<tr>
	<th rowspan=2>Date</th>
	<th align='center' colspan=2=>Income</th>
	<th align='center'colspan=4>Expense</th>
	<th align='right' rowspan=2>Distribution</th>
	<th align='right' rowspan=2>Balance</th>
	</tr>
	<tr>
	<th align='right'>Payment</th>
	<th align='right'>Rent</th>
	<th align='right'>Fee</th>
	<th align='right'>Percent</th>
	<th align='right'>OnBoard</th>
	<th align='right'>Upkeep</th>
	</tr>
</thead>

<tbody>
	<% lastyear = "" %>
	<% @months.each do |month, values| %>
		<% year = month[0..3] %>
		<% if lastyear != '' && year != lastyear %>
			<tr>
			<td class='center bold'><%= lastyear %></td>
			<td class='bold' align='right'><%= number_with_precision(@totals[lastyear]['payment'], precision:2) %></td>
			<td class='bold' align='right'><%= number_with_precision(@totals[lastyear]['rent'], precision:2) %></td>
			<td class='bold' align='right'><%= number_with_precision(@totals[lastyear]['fee'], precision:2) %></td>
			<td class='bold' align='right'><%= number_with_precision(@totals[lastyear]['percent'], precision:2) %>%</td>
			<td class='bold' align='right'><%= number_with_precision(@totals[lastyear]['onboard'], precision:2) %></td>
			<td class='bold' align='right'><%= number_with_precision(@totals[lastyear]['upkeep'], precision:2) %></td>
			<td class='bold' align='right'><%= number_with_precision(@totals[lastyear]['distribution'], precision:2) %></td>
			<td></td>
			</tr>
		<% end %>
		<tr>
		<td><%= month %></td>
		<td align='right'><%= number_with_precision(values['payment'], precision:2) %></td>
		<td align='right'><%= number_with_precision(values['rent'], precision:2) %></td>
		<td align='right'><%= number_with_precision(values['fee'], precision:2) %></td>
		<td align='right'><%= number_with_precision(values['percent'], precision:2) %>%</td>
		<td align='right'><%= number_with_precision(values['onboard'], precision:2) %></td>
		<td align='right'><%= number_with_precision(values['upkeep'], precision:2) %></td>
		<td align='right'><%= number_with_precision(values['distribution'], precision:2) %></td>
		<td align='right'><%= number_with_precision(values['balance'], precision:2) %></td>
		</tr>
		<% lastyear = year %>
	<% end %>
</tbody>
</table>
