
<%# render 'layouts/autosave', formname: FORMNAME, pageurl: PAGEURL, posturl: POSTURL %>
<script>
	setTimeout(function() {
		autosave("#<%= formname %>", "<%= pageurl %>", "<%= posturl %>");
	}, 30000);
</script>

<div class='autosavebox'><span id='autosavebox'></span></div>
<p class='hilite-alert-md'><b>Note: </b>This form autosaves every 30 seconds</p>
