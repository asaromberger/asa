<h1><%= @title %></h1>

<%= render 'layouts/autosave', formname: "edit_permission_#{@autosave.id}", pageurl: edit_autosave_path(id: 0), posturl: autosave_path(id: 0) %>

<%= form_for [:permission, @autosave], url: autosave_path(0), html: {method: :put} do |form| %>
	<%= form.fields_for :pvalue, @autosave.pvalue do |result| %>
		<% [:field1, :field2, :field3, :field4].each do |field| %>
			<%= result.label field, field %>
			<%= result.text_area field, value: @autosave.pvalue[field.to_s].presence || '' %>
		<% end %>
	<% end %>
	<%= form.submit "Save", class: 'btn btn-primary col-xs-2' %>
<% end %>
